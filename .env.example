# marathon settings and API keys. Copy this file to .env, then fill in what you need:
#
#   cp .env.example .env
#
# Keep .env in this folder (the marathon-agent checkout). Never put it in the repo the agent
# works on, because the agent can read files there. .env is git-ignored.
# A command-line flag beats a real environment variable, which beats this file.
# Empty values are ignored, so the built-in default applies.

# ------------------------------------------------------------------ API keys
# Fill in the keys for the providers you use. The agent's commands never see them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# For a custom OpenAI-compatible server (MARATHON_BASE_URL), or to override the main model's key
MARATHON_API_KEY=

# ------------------------------------------------------------------ models, as provider:model
# Providers: anthropic, openai, openrouter, ollama (no key needed, runs on your machine)
MARATHON_MODEL=anthropic:claude-sonnet-5-5
# The test writer and ask_subagent. Empty = MARATHON_MODEL
MARATHON_HELPER_MODEL=
# The judge. Empty = MARATHON_MODEL. A judge from another model family is a cheap second opinion.
MARATHON_JUDGE_MODEL=
# The provider for a model name with no provider in front
MARATHON_PROVIDER=openai
# A custom OpenAI-compatible server, like http://localhost:8000/v1. Empty = the provider's own.
MARATHON_BASE_URL=
# Longest reply, in tokens (Anthropic needs a limit)
MARATHON_MAX_TOKENS=16000

# ------------------------------------------------------------------ the fixes: every N ...
# Fix 1: re-read goal.md when step % N == 0. A step is one checkpoint commit. 0 turns it off.
MARATHON_REREAD_EVERY=5
# Fix 1, backup schedule: also re-read every N model turns. 0 turns it off.
MARATHON_REREAD_EVERY_TURNS=20
# Fix 2 and 9: run the tests every N steps. 1 = at every checkpoint. finish always runs them.
MARATHON_TEST_EVERY=1
# Fix 3: after N test runs in a row without progress, tell the agent to note why and switch
# approach. 0 turns it off.
MARATHON_SWITCH_AFTER=3
# Fix 3: after N test runs in a row without progress, drop the attempt and start fresh
MARATHON_PATIENCE=25
# Fresh starts before the run gives up
MARATHON_MAX_ATTEMPTS=5
# Fix 9: model turns without a checkpoint before the harness makes one itself
MARATHON_FORCE_CHECKPOINT_EVERY=15
# Fix 5: messages kept in the context before the oldest are dropped
MARATHON_MAX_HISTORY=80
# Fix 5: characters of tool output shown inline; the rest is saved to a file
MARATHON_TOOL_OUTPUT_LIMIT=6000

# ------------------------------------------------------------------ budget for one run
MARATHON_HOURS=8
MARATHON_MAX_TURNS=600
# Seconds for any one shell command, tests included
MARATHON_CMD_TIMEOUT=300

# ------------------------------------------------------------------ goal and tests
MARATHON_GOAL_FILE=goal.md
MARATHON_TESTS_DIR=tests
# Empty = an isolated unittest run of tests/ (see marathon/config.py). Other examples:
#   MARATHON_TEST_CMD=make test
#   MARATHON_TEST_CMD=python3 -m pytest -q
MARATHON_TEST_CMD=
# More read-only paths, comma-separated. Example: Makefile,conftest.py
MARATHON_PROTECT=
# Optional, for objective goals: a command that prints a number, higher is better
MARATHON_SCORE_CMD=
# Smallest score gain that counts as progress
MARATHON_MIN_DELTA=0

# ------------------------------------------------------------------ where commands run (Fix 8)
# docker, podman, nerdctl, or local (directly on this machine). With Colima, use docker.
MARATHON_SANDBOX=docker
MARATHON_IMAGE=python:3.12-slim
# Let commands in containers use the network
MARATHON_ALLOW_NETWORK=false
